# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT & APP_URL: Server port and public URL
PORT=3000
APP_URL="http://localhost:3000"

# Optional Firebase Project ID override for server token verification
# (Defaults to projectId in firebase-applet-config.json if omitted)
# FIREBASE_PROJECT_ID="your-firebase-project-id"

# Optional Client Firebase Overrides (defaults to firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_DATABASE_ID="(default)"
